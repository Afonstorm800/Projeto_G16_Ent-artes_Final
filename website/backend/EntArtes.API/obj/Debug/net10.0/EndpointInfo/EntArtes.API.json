  "components": {
    "schemas": {
      "ApproveLoanDto": {
        "type": "object",
        "properties": {
          "taxaAplicada": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "BillingRequest": {
        "type": "object",
        "properties": {
          "ano": {
            "type": "integer",
            "format": "int32"
          },
          "mes": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "BookingRequestDto": {
        "type": "object",
        "properties": {
          "dataHoraInicio": {
            "type": "string",
            "format": "date-time"
          },
          "dataHoraFim": {
            "type": "string",
            "format": "date-time"
          },
          "formato": {
            "$ref": "#/components/schemas/FormatoAula"
          },
          "objetivo": {
            "type": "string",
            "nullable": true
          },
          "modalidadeId": {
            "type": "integer",
            "format": "int32"
          },
          "professorId": {
            "type": "integer",
            "format": "int32"
          },
          "estudioId": {
            "type": "integer",
            "format": "int32"
          },
          "alunosIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "FormatoAula": {
        "enum": [
          0,
          1,
          2,
          3
        ],
        "type": "integer",
        "format": "int32"
      },
      "IndividualBillingRequest": {
        "type": "object",
        "properties": {
          "ano": {
            "type": "integer",
            "format": "int32"
          },
          "mes": {
            "type": "integer",
            "format": "int32"
          },
          "encarregadoId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "ItemSubmissionDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "nullable": true
          },
          "descricao": {
            "type": "string",
            "nullable": true
          },
          "categoria": {
            "type": "string",
            "nullable": true
          },
          "estadoConservacao": {
            "type": "string",
            "nullable": true
          },
          "fotoUrl": {
            "type": "string",
            "nullable": true
          },
          "taxaSimbolica": {
            "type": "number",
            "format": "double"
          },
          "precoVenda": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "tipo": {
            "$ref": "#/components/schemas/TipoItem"
          }
        },
        "additionalProperties": false
      },
      "LoanRequestDto": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "integer",
            "format": "int32"
          },
          "dataFimPrevisto": {
            "type": "string",
            "format": "date-time"
          },
          "observacoes": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginDto": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RegisterDto": {
        "required": [
          "email",
          "nome",
          "password",
          "tipo"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 6,
            "type": "string"
          },
          "tipo": {
            "$ref": "#/components/schemas/TipoUtilizador"
          }
        },
        "additionalProperties": false
      },
      "TipoItem": {
        "enum": [
